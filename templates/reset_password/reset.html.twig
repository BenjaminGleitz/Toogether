{% extends 'base.html.twig' %}

{% block title %}{{ 'user.reset_password.title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'user.reset_password.title'|trans }}</h1>

    {{ form_start(resetForm) }}
        {{ form_row(resetForm.plainPassword) }}
        <button class="btn btn-primary">{{ 'user.reset_password.reset.submit'|trans }}</button>
    {{ form_end(resetForm) }}
{% endblock %}
